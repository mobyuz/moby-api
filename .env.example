# Local development values. Export them before running the binary on the host.
MOBY_BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://moby:moby_dev@127.0.0.1:55432/moby?sslmode=disable
MOBY_DEV_SMTP_HOST=127.0.0.1
MOBY_DEV_SMTP_PORT=1025
MOBY_MAIL_FROM=noreply@moby.test
MOBY_ACCOUNT_BASE_URL=http://127.0.0.1:8080/
MOBY_TERMS_VERSION=dev-1
MOBY_PRIVACY_POLICY_VERSION=dev-1
MOBY_CLOUD_VOICE_VERSION=dev-1
# Loopback uses a temporary signing key unless a 32-byte hex seed is set.
# MOBY_AUTH_SIGNING_SEED=
# MOBY_AUTH_PREVIOUS_PUBLIC_KEYS=
# Set all three values to enable Google sign-in.
# MOBY_GOOGLE_CLIENT_ID=
# MOBY_GOOGLE_CLIENT_SECRET=
# MOBY_GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/auth/google/callback
MOBY_AGENT_ENABLED=true
MOBY_LLM_DAILY_TOKENS=250000
MOBY_LLM_DAILY_BUDGET_MICROUSD=0
MOBY_LLM_MONTHLY_BUDGET_MICROUSD=0
MOBY_VOICE_ENABLED=false
MOBY_STT_DAILY_SECONDS=300
MOBY_TTS_DAILY_CHARS=5000
MOBY_DEMO_ENABLED=false
# MOBY_TURNSTILE_SECRET_KEY=
# MOBY_DEMO_HOSTNAME=demo.example.test
MOBY_DEMO_REQUESTS_PER_15_MINUTES=12
MOBY_DEMO_DAILY_TOKENS=60000
MOBY_DEMO_DAILY_BUDGET_MICROUSD=0
MOBY_DEMO_MONTHLY_BUDGET_MICROUSD=0
